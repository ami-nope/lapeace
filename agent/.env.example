PANEL_API_TOKEN=replace-with-at-least-32-random-bytes
AWG_INTERFACE=awg0
AWG_CONFIG_FILE=/etc/amnezia/amneziawg/awg0.conf
AWG_CLIENT_STATE_FILE=/var/lib/lapeace-agent/awg-clients.json
AWG_SERVER_ENDPOINT=replace-with-public-hostname-or-ip:51820
AWG_CLIENT_ALLOWED_IPS=0.0.0.0/0
AWG_CLIENT_DNS=1.1.1.1
MONITOR_STATE_FILE=/opt/lapeace/data/usage.json
DYNAMIC_SSH_ENABLED=false
DYNAMIC_REGISTRY_API_URL=https://lapeace.amii.lol/api/dynamic-ssh/sync/registry
DYNAMIC_SYNC_STATUS_URL=https://lapeace.amii.lol/api/dynamic-ssh/sync/status
DYNAMIC_SYNC_TOKEN=replace-with-a-different-random-secret
DYNAMIC_IP_STATE_FILE=/var/lib/lapeace-agent/dynamic-ssh-managed.json
DYNAMIC_IP_PROTECTED=replace-with-comma-separated-protected-ips
DYNAMIC_IP_PROTECTED_INVENTORY_CONFIRMED=false
