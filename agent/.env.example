PANEL_API_TOKEN=replace-with-at-least-32-random-bytes
AWG_INTERFACE=awg0
MONITOR_STATE_FILE=/opt/lapeace/data/usage.json
DYNAMIC_SSH_ENABLED=false
DYNAMIC_REGISTRY_API_URL=https://lapeace.amii.lol/api/dynamic-ssh/sync/registry
DYNAMIC_SYNC_STATUS_URL=https://lapeace.amii.lol/api/dynamic-ssh/sync/status
